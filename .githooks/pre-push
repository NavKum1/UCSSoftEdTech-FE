#!/bin/sh
# Before every push: the feature register check, which lives in the Edulexa root repository next to this one
# (../scripts/features/check.mjs). Every page and API route belongs to exactly one feature. Set up by scripts/dev.ps1.
check="$(git rev-parse --show-toplevel)/../scripts/features/check.mjs"
if [ ! -f "$check" ]; then
  echo "Feature register check not found at $check (clone the Edulexa root repository next to this one); skipped."
  exit 0
fi
if ! node "$check"; then
  echo "Push stopped: fix the feature register in the root repository (docs/feature_register.json), then push again."
  exit 1
fi
# S4 help center: every article's button labels, links and features still match the app (docs/s4_help_center_plan.md)
if ! npx --no-install tsx scripts/help-build.ts --check; then
  echo "Push stopped: fix the help articles in content/help (or rebuild them: npx tsx scripts/help-build.ts), then push again."
  exit 1
fi
